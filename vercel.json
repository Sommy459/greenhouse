{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"services": {
		"web": {
			"root": "apps/web",
			"framework": "nextjs"
		},
		"vendor": {
			"root": "apps/vendor",
			"framework": "nextjs"
		},
		"admin": {
			"root": "apps/admin",
			"framework": "nextjs"
		}
	},
	"rewrites": [
		{ "source": "/admin", "destination": { "service": "admin" } },
		{ "source": "/admin/(.*)", "destination": { "service": "admin" } },
		{ "source": "/vendor", "destination": { "service": "vendor" } },
		{ "source": "/vendor/(.*)", "destination": { "service": "vendor" } },
		{ "source": "/(.*)", "destination": { "service": "web" } }
	]
}
