# Copy to .env.local.

# The external Fysi API's base URL. The browser calls this app's /api/v1 proxy (next.config.ts), which forwards here.
API_PROXY_TARGET=

# Or force direct calls from the browser instead of the proxy (the API must allow this origin in CORS).
# NEXT_PUBLIC_API_URL=https://api.example.com/api/v1

# TEMPORARY: 1 = fake answers for sign in, sign up and "Set up your shop" (src/lib/api/mock.ts).
# new@fysi.ng / Password1 (no shop yet), vendor@fysi.ng / Password1 (approved shop). Restart `pnpm dev` after changing.
# NEXT_PUBLIC_MOCK_API=1

# Canonical URLs (optional) — src/lib/site.ts. On Vercel: the shared domain's origin (e.g. https://fysi.ng), the same
# for all three services; this app is served under /vendor (next.config.ts basePath), the storefront at the root.
# NEXT_PUBLIC_SITE_URL=http://localhost:3001
# NEXT_PUBLIC_STORE_URL=http://localhost:3000
