# Copy to .env.local.

# The external Fysi API's base URL. The browser calls this app's /api/v1 proxy (next.config.ts), which forwards here.
API_PROXY_TARGET=

# Or force direct calls from the browser instead of the proxy (the API must allow this origin in CORS).
# NEXT_PUBLIC_API_URL=https://api.example.com/api/v1

# TEMPORARY: 1 = fake answers for sign in / sign up (src/lib/api/mock.ts) until the API is connected.
# Demo account demo@fysi.ng / Password1, one-time code 1234. Restart `pnpm dev` after changing it.
# NEXT_PUBLIC_MOCK_API=1

# Canonical URLs (optional) — src/lib/site.ts. On Vercel: the shared domain (e.g. https://fysi.ng), the same for all
# three services; the seller centre is then <origin>/vendor. Locally they default to localhost ports.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
# NEXT_PUBLIC_VENDOR_URL=http://localhost:3001/vendor
